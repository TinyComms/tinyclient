# Served by Cloudflare Pages with every response. The pages carry the same policy in a <meta> tag
# so a copy opened from disk is held to it too; the header adds what a <meta> cannot:
# frame-ancestors, HSTS and the rest.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Screenshots are renamed when they change (inbox-2.webp, ...), so a name never changes content.
/shots/*
  Cache-Control: public, max-age=31536000, immutable

# The pages and their stylesheet change together; a stale stylesheet under a new page breaks it.
/style.css
  Cache-Control: public, max-age=0, must-revalidate
/site.js
  Cache-Control: public, max-age=0, must-revalidate

# Discovery documents. Link is repeated by the Pages function so a cached HTML
# response still advertises the catalog.
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </docs/>; rel="service-doc", </.well-known/openapi.json>; rel="service-desc", </llms.txt>; rel="describedby", </.well-known/ai-catalog.json>; rel="describedby"
/index.html
  Link: </.well-known/api-catalog>; rel="api-catalog", </docs/>; rel="service-doc", </.well-known/openapi.json>; rel="service-desc", </llms.txt>; rel="describedby", </.well-known/ai-catalog.json>; rel="describedby"

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/.well-known/openapi.json
  Content-Type: application/vnd.oai.openapi+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=0, must-revalidate
/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/.well-known/agent-skills/tinyclient/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
